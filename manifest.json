{
  "manifest_version": 3,
  "name": "YouTube Sponsor Segment Skipper",
  "version": "0.1.0",
  "description": "Analyzes captions ahead of playback to skip sponsor reads, with local speech-to-text as a fallback.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://*.youtube.com/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["timeline.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
